PORT=3000
APP_BASE_URL=http://localhost:3000
NODE_ENV=development

# Mercado Pago: "mock" para pruebas locales sin credenciales, "real" para integracion real
MERCADO_PAGO_MODE=mock
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_CURRENCY=ARS
# Email para precargar en checkout (ideal: comprador de prueba de Mercado Pago)
MERCADO_PAGO_PAYER_EMAIL=
# true: checkout orientado a invitado/tarjeta (menos friccion en pruebas)
MERCADO_PAGO_GUEST_CHECKOUT=true
# true: si MP real falla, redirige al checkout simulado para no cortar la venta demo
MERCADO_PAGO_FALLBACK_TO_MOCK=true
# true: con Access Token TEST-* fuerza checkout mock para evitar loops del sandbox
MERCADO_PAGO_TEST_TOKEN_FORCE_MOCK=true

# Si tus precios estan en USD, usamos este factor para convertir a ARS
FX_USD_TO_ARS=1400

# Correo Argentino: "mock" o "real"
CORREO_ARGENTINO_MODE=mock
CORREO_ARGENTINO_API_URL=
CORREO_ARGENTINO_API_TOKEN=

# Shipping provider desacoplado (adapter)
SHIPPING_PROVIDER=mock
SHIPPING_FALLBACK_TO_MOCK=true
SHIPPING_AUTO_CREATE_ON_CUSTOMER_FORM=false

# Costos simples por zona (ARS)
SHIPPING_DEFAULT_ZONE=INTERIOR
SHIPPING_COST_CABA=10500
SHIPPING_COST_GBA=5000
SHIPPING_COST_INTERIOR=8000

# Correo Argentino API 2.0 (paq.ar)
# Habilita/deshabilita la integracion API sin tocar el resto del sistema
CORREO_ARG_ENABLED=false
CORREO_ARG_BASE_URL=
CORREO_ARG_API_KEY=
CORREO_ARG_AGREEMENT=
CORREO_ARG_LABEL_FORMAT=10x15

# Alias legacy (compatibilidad con codigo existente)
CORREO_ARG_API_BASE_URL=

# Email de confirmacion post-compra
# Si EMAIL_ENABLED=false, la compra se confirma igual y solo se loguea el no-envio.
EMAIL_ENABLED=false
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Datos showroom para email de retiro en tienda
STORE_NAME=SantelmoComputacion
PICKUP_SHOWROOM_ADDRESS=San Martin 50 Piso 8 Oficina 166
PICKUP_SHOWROOM_LOCALITY=Ciudad Autonoma de Buenos Aires
PICKUP_SHOWROOM_HOURS=Lunes a Viernes de 10:00 a 18:00

# No exponer en front. Solo backend para correlacion interna
WEBHOOK_SHARED_SECRET=

# Panel admin interno
# Token obligatorio recomendado para proteger /api/admin/*
ADMIN_PANEL_TOKEN=
# En produccion conviene true. En desarrollo puede quedar false para pruebas rapidas.
ADMIN_PANEL_TOKEN_REQUIRED=false

# Modo diagnostico del flujo (logs detallados en consola backend)
FLOW_DIAGNOSTIC=false
